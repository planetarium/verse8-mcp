#!/bin/sh
# Same dispatcher verse8_attach installs (attach writes its own in-code copy
# of this script; this file is not read). Validates the proposed commit
# message against the V8 format: format drift is rejected (exit 1), missing
# narrative only warns. The heavy lifting is in the verse8-mcp binary so the
# logic stays in one place.
exec verse8-mcp hook commit-msg "$@"
