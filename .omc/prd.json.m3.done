    {
      "id": "US-M3-1",
      "title": "util/auditLog.ts — rotating JSONL at $XDG_STATE_HOME/verse8/mcp.log (+ tests/unit/auditLog.test.mjs)",
      "priority": 1,
      "passes": true,
      "files": [
        "src/util/auditLog.ts (new)",
