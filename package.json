{
  "name": "@verse8/mcp",
  "version": "0.8.0",
  "description": "Verse8 MCP meta-server — auto-detects gitlab.verse8.io projects and exposes verse8 skills, image MCP proxy, and git checkpoint tools to host LLMs (Claude, Codex, Cursor, opencode, etc.)",
  "keywords": [
    "mcp",
    "verse8",
    "agent8",
    "claude",
    "game-dev"
  ],
  "license": "MIT",
  "homepage": "https://github.com/planetarium/verse8-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planetarium/verse8-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/planetarium/verse8-mcp/issues"
  },
  "type": "module",
  "bin": {
    "verse8-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "hooks/",
    "skills/",
    "skills-vendor/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "bash tests/smoke.sh && npm run test:unit",
    "test:smoke": "bash tests/smoke.sh",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "clean": "rm -rf dist",
    "check:subtree-sha": "bash scripts/check-subtree-sha.sh",
    "sync:agent8-skills": "node scripts/sync-agent8-skills.mjs",
    "audit": "npm audit --audit-level=high",
    "prepublishOnly": "npm run build && bash scripts/prepublish-guard.sh && node --test tests/unit/pluginManifest.test.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "verse8": {
    "skillsVendor": {
      "sha": "354f8e4d4c84aee1c3c980e5bc23ade7ff479624fda9df83e557e94945def757",
      "upstream": {
        "repo": "planetarium/agent8-skills",
        "commit": "11a5c979f6e403129a6fd8d64be7906bcce09c87"
      }
    },
    "gameserverPin": {
      "gameserver-node": "latest",
      "deploy": "latest"
    }
  }
}
