{
  "name": "@verse8/mcp",
  "version": "0.6.0",
  "description": "Verse8 MCP meta-server — auto-detects gitlab.verse8.io projects and exposes verse8 skills, image MCP proxy, and git checkpoint tools to host LLMs (Claude, Codex, Cursor, opencode, etc.)",
  "keywords": [
    "mcp",
    "verse8",
    "agent8",
    "claude",
    "game-dev"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "verse8-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "hooks/",
    "skills/",
    "skills-vendor/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "bash tests/smoke.sh && npm run test:unit",
    "test:smoke": "bash tests/smoke.sh",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "clean": "rm -rf dist",
    "check:subtree-sha": "bash scripts/check-subtree-sha.sh",
    "audit": "npm audit --audit-level=high",
    "prepublishOnly": "npm run build && bash scripts/prepublish-guard.sh"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "verse8": {
    "skillsVendor": {
      "sha": "64b5d9cdf2a4f210c8386791af34707b54cab155606596c980e73fed58b86dc0"
    },
    "gameserverPin": {
      "gameserver-node": "latest",
      "deploy": "latest"
    }
  }
}
